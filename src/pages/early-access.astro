---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="HoundStack updates: product news by email"
  description="HoundStack is available now. Leave your email for product news, what shipped this month, and what is coming next. No sales sequence."
>
  <section class="page-hero">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">Stay in touch</span>
        <h1>Product news, once in a while</h1>
        <p class="lede">
          HoundStack is available today, so there is nothing to wait for: you can
          <a href={SITE.signupUrl}>start a free trial</a> right now. This list is for
          afterwards, or instead, if you would rather read than sign up.
        </p>
        <ul class="checklist ea-list">
          <li>
            <Icon name="check" size={20} />
            <span><strong>What shipped.</strong> A short note when something lands that changes how a day runs, not a release log.</span>
          </li>
          <li>
            <Icon name="check" size={20} />
            <span><strong>What is coming.</strong> The next things on the <a href="/roadmap">roadmap</a>, while there is still time to argue with them.</span>
          </li>
          <li>
            <Icon name="check" size={20} />
            <span><strong>A say in what ships first.</strong> Tell us what your operation needs and it goes straight onto the <a href="/roadmap">roadmap</a> pile.</span>
          </li>
        </ul>
        <p class="muted">
          Questions first? The <a href="/contact">contact form</a> reaches a person who will answer within one business day.
        </p>
      </div>
      <div class="reveal">
        <h2 class="ea-form-h">Get product news by email</h2>
        <p class="muted ea-form-p">
          Takes about twenty seconds. No spam, and you can unsubscribe with one click.
        </p>
        <LeadForm
          endpoint={SITE.earlyAccessFormEndpoint}
          eventName="Early Access Submitted"
          messageLabel="What should HoundStack nail for your business? (optional)"
          messagePlaceholder="Current software, team size, the thing you most want fixed"
          submitLabel="Send me product news"
          redirectTo="/thank-you"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .ea-list {
    margin-bottom: 20px;
  }

  .ea-form-h {
    font-size: 1.3rem;
  }

  .ea-form-p {
    margin-bottom: 20px;
  }
</style>
