---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="You're on the list | HoundStack"
  description="Thanks for getting in touch with HoundStack. We'll reply shortly, and you can start your free trial in the meantime."
  noindex
>
  <section class="page-hero">
    <div class="container-narrow text-center">
      <span class="ty-mark"><Icon name="check" size={30} /></span>
      <span class="eyebrow">Message received</span>
      <h1>Thanks, we'll be in touch</h1>
      <p class="lede ty-lede">
        A person will read this and reply by email, usually within one business day. You do not
        have to wait for us to start: HoundStack is available now, and your free trial takes about
        two minutes to set up.
      </p>
      <div class="ty-actions">
        <a href={SITE.signupUrl} class="btn btn-primary">Start your free trial</a>
        <a href="/features" class="btn btn-ghost">Explore the features</a>
      </div>
      <p class="muted ty-note">
        Something urgent in the meantime? <a href="/contact">Contact us</a> and a person will
        answer within one business day.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(64px, 9vw, 110px);
  }

  .ty-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--sage-wash);
    border: 1px solid var(--sage);
    color: var(--sage-dark);
    margin: 0 auto 18px;
  }

  .ty-lede {
    max-width: 38em;
    margin-inline: auto;
  }

  .ty-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .ty-note {
    margin-top: 20px;
    font-size: 0.92rem;
  }
</style>
