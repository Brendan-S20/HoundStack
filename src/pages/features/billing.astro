---
import FeatureLayout from '../../layouts/FeatureLayout.astro';
import Screenshot from '../../components/Screenshot.astro';
import Icon from '../../components/Icon.astro';

const features = [
  {
    title: 'Prepaid credits or postpaid invoices',
    body: 'Run clients on a prepaid credit ledger that draws down per visit, or invoice after the work. Mix both across your book.',
  },
  {
    title: 'Stripe, your key, your rate',
    body: 'Connect your own Stripe account. Cards run at Stripe\u2019s standard 2.9% + 30\u00a2 and bank payments at 0.8% capped at $5, billed by Stripe straight to your account, and the money settles to you.',
  },
  {
    title: 'Skip reason billing rules',
    body: 'A locked gate is not the same as a rain day. Bill full, prorate, or waive automatically depending on why the visit was skipped.',
  },
  {
    title: 'Automatic overdue reminders',
    body: 'Reminders go out on a schedule you set, so chasing money stops being an evening job.',
  },
  {
    title: 'Client portal',
    body: 'Clients view and pay invoices themselves, see their visit history, and update their card without calling you.',
  },
  {
    title: 'Promotions and coupon codes',
    body: 'Run a spring cleanup special or a first month discount with a code. The discount applies itself on the invoice instead of living in a sticky note.',
  },
  {
    title: 'A trial that is actually free',
    // "14 days of Launch free" implied the AI features too, which the app gates
    // on a paid plan. Naming the one exclusion here is the difference between a
    // caveat and a surprise.
    body: 'Every account starts with 14 days of Launch free, no credit card, purely time based. Nothing you do inside the trial triggers a charge. The AI features are the one thing it does not include, because they cost us real money to run.',
  },
];
---

<FeatureLayout
  metaTitle="Pet waste removal invoicing software | HoundStack billing"
  metaDescription="Billing for pet waste removal: prepaid credits or postpaid invoices, per dog pricing, skip reason rules, Stripe with your own key, and a client portal."
  h1="Invoicing software that knows why the visit was skipped"
  eyebrow="Billing and payments"
  intro="Billing in this trade has edge cases generic tools fumble: rain days, locked gates, prepaid punch cards, per dog rates. HoundStack handles each one with a rule, not a workaround, on your own Stripe account."
  crumbLabel="Billing and payments"
  switchHref="/switch/from-jobber"
  switchText="switching from Jobber"
>
  <section class="section-alt">
    <div class="container split">
      <div class="reveal">
        <h2>Skip rules do the awkward math</h2>
        <p class="lede">
          Every skip carries a reason, and every reason carries a billing rule you chose in
          advance. The invoice comes out right without anyone remembering what happened two
          Tuesdays ago.
        </p>
        <ul class="checklist">
          <li>
            <Icon name="check" size={20} />
            <span><strong>Your Stripe, your money.</strong> Bring your own key. Cards are 2.9% + 30&cent;, bank payments 0.8% capped at $5, billed by Stripe to your account.</span>
          </li>
          <li>
            <Icon name="check" size={20} />
            <span><strong>Two billing styles, one book.</strong> Prepaid credit ledgers for some clients, monthly invoices for others, side by side.</span>
          </li>
        </ul>
      </div>
      <div class="reveal">
        {/* The real invoice list from the demo organization. It shows what
            the recreation could only assert: prepaid top-ups and postpaid
            invoices sitting in one book, each with its own period, due date
            and sent date. */}
        <Screenshot
          src="/screenshots/04-invoice-1440x900.png"
          width={1440}
          height={900}
          alt="The Invoices page: outstanding balance, open invoice count and collected this month across the top, then a table of invoices by client showing period, due date, total and status, with prepaid top-ups and postpaid invoices side by side."
        />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="reveal">Everything in billing and payments</h2>
      <div class="grid-2 detail-grid">
        {
          features.map((f) => (
            <div class="card reveal">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</FeatureLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .detail-grid {
    margin-top: 32px;
  }
</style>
