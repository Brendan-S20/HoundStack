---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingEstimator from '../components/PricingEstimator.astro';
import FaqBlock from '../components/FaqBlock.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import {
  PLANS,
  SITE,
  ORG_ID,
  PRODUCT_ID,
  TRIAL_DAYS,
  OVERAGE_RATE,
  ANNUAL_DISCOUNT,
  PRICING_FAQS,
  TIER_FEATURE_GROUPS,
} from '../lib/site';

const pricingUrl = new URL('/pricing', SITE.url).href;

// MKT-6. Two things this deliberately does NOT say:
//
// `availability` is PreOrder, not InStock. Every plan CTA on this page reads
// "Coming soon" and links to the early access list, because the app is not
// open yet. Publishing InStock would put a buyable price in a search result
// for something nobody can buy — the same class of claim MKT-2 removed from
// the copy, just in a place a human reviewer never reads. Flip it to InStock
// in the same change that turns the CTAs into real signup links, not before.
//
// No `aggregateRating` / `review`: there are no customers yet, so there is
// nothing to aggregate. Enterprise is absent from `offers` for the same
// reason it has no number on the page — it is priced by contract, and a
// schema Offer cannot say "by contract" without inventing a figure.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': PRODUCT_ID,
  name: 'HoundStack',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Field Service Management',
  operatingSystem: 'Web',
  url: SITE.url,
  description:
    'Business software for pet waste removal companies: scheduling, route optimization, invoicing and payments, a field app, and a client portal.',
  image: new URL('/og.png', SITE.url).href,
  publisher: { '@id': ORG_ID },
  offers: PLANS.filter((p) => p.price !== null).map((p) => ({
    '@type': 'Offer',
    name: `HoundStack ${p.name}`,
    price: String(p.price),
    priceCurrency: 'USD',
    availability: 'https://schema.org/PreOrder',
    url: pricingUrl,
    description: `$${p.price} per month with ${p.includedEmployees} active employees included. Additional active employees are $${OVERAGE_RATE} per month each.`,
  })),
};

// Add-on detail blurbs. Availability itself lives in TIER_FEATURE_GROUPS
// (rendered inside every tier card); this section only explains what
// each add-on does.
// MKT-1: this list is now the app's real add-on catalog (platform_addons),
// with the app's own prices. It previously advertised four add-ons of which
// THREE did not exist in the app at all — AI Business Advisor (never built;
// the weekly digest it described is a plan feature, not a SKU), Referral
// Programs (un-gated and included on every plan, not something to buy), and
// Franchise Management (an Enterprise capability, already listed as such under
// "Franchise and multi-brand") — while omitting five that do exist.
//
// Availability is stated per add-on rather than blanket "available at launch",
// because two of these are not built yet and one is gated on regulatory
// approval outside our control. Saying otherwise is the MKT-2 mistake again.
const addons = [
  {
    icon: 'spark',
    name: 'AI Receptionist',
    price: '$49/mo',
    body: 'Answers client texts about pricing and availability and books straight into the calendar. Texts today; voice calls are on the roadmap and will be labeled when live.',
    availability: 'Add-on, every plan',
  },
  {
    icon: 'message',
    name: 'Managed texting',
    price: '$29/mo',
    body: 'We supply the number and handle carrier registration, so you are not standing up your own Twilio account to send appointment texts.',
    // Gated on 10DLC/A2P brand and campaign approval, which is a registrar
    // queue measured in days to weeks and not ours to accelerate.
    availability: 'Coming soon',
  },
  {
    icon: 'network',
    name: 'White-label client portal',
    price: '$19/mo',
    body: 'Your own domain on the client portal, so the people you serve see your business rather than ours.',
    availability: 'Coming soon',
  },
  {
    icon: 'mail',
    name: 'White-label emails',
    price: '$19/mo',
    body: 'Client emails sent from your domain, authenticated so they land in the inbox rather than the spam folder.',
    availability: 'Coming soon',
  },
  {
    icon: 'shield',
    name: 'Priority support',
    price: '$29/mo',
    body: 'Front of the queue for support, with a same business day response commitment.',
    availability: 'Add-on, every plan',
  },
  {
    icon: 'users',
    name: 'Done-for-you setup',
    price: '$499 one time',
    body: 'We import your clients, properties, and schedule from your current software and get you running, instead of handing you an import tool and wishing you luck.',
    availability: 'One-time service',
  },
];

const faqs = PRICING_FAQS;

// MKT-6: there used to be a second, hand-built FAQPage here, passed to the
// layout alongside the one <FaqBlock> already emits from the same array —
// two identical FAQPage nodes on one page. FaqBlock is the single emitter;
// it builds the schema from exactly the questions it renders, which is the
// property that keeps the two from drifting.

const discountPct = Math.round(ANNUAL_DISCOUNT * 100);

/** Per-month price under yearly billing, formatted without trailing .00 */
const yearlyMonthly = (price: number) => {
  const v = price * (1 - ANNUAL_DISCOUNT);
  return Number.isInteger(v) ? String(v) : v.toFixed(2);
};
---

<BaseLayout
  title="Pooper scooper software pricing | HoundStack"
  description="HoundStack pricing: Launch $79, Growth $199, Scale $449, Enterprise by contract. Employee allowance on every tier, $10 per extra active employee."
  schema={[softwareSchema]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h1>Pooper scooper software pricing that stays predictable</h1>
      <p class="lede">
        Pick the tier that fits your operation. Every tier includes an employee allowance (your
        first 3 teammates on Launch), and each additional active employee is ${OVERAGE_RATE} a
        month flat, shown live in your billing dashboard as it happens, never a surprise line on
        an invoice.
      </p>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="tiers-head reveal">
        <div>
          <h2>Four tiers, one ladder</h2>
          <p class="lede">
            Every plan runs the full core ERP with nothing held back. What changes as you move up
            is the tooling a more complex operation actually needs.
          </p>
        </div>
        <div class="billing-toggle" role="group" aria-label="Billing period" id="billing-toggle">
          <button type="button" class="bt-opt is-active" data-billing-opt="monthly" aria-pressed="true">
            Monthly
          </button>
          <button type="button" class="bt-opt" data-billing-opt="yearly" aria-pressed="false">
            Yearly &middot; save {discountPct}%
          </button>
        </div>
      </div>
      <div class="plan-grid" id="plan-grid">
        {
          PLANS.map((p, i) => (
            <div class={`card plan-card reveal ${p.popular ? 'plan-popular' : ''}`}>
              {p.popular && <span class="badge badge-sage popular-badge">Most popular</span>}
              <h3>{p.name}</h3>
              <p class="plan-price">
                {p.price !== null ? (
                  <>
                    <span class="price-monthly">
                      <span class="plan-amount">${p.price}</span>
                      <span class="plan-suffix">/mo</span>
                    </span>
                    <span class="price-yearly">
                      <span class="plan-amount">${yearlyMonthly(p.price)}</span>
                      <span class="plan-suffix">/mo</span>
                      <span class="plan-billed">billed yearly</span>
                    </span>
                  </>
                ) : (
                  <span class="plan-amount plan-custom">By contract</span>
                )}
              </p>
              <p class="plan-emp">
                {p.includedEmployees !== null
                  ? `${p.includedEmployees} active employees included`
                  : 'Custom employee allowance'}
              </p>
              <p class="plan-blurb">{p.audience}</p>
              {p.price !== null ? (
                <a
                  href={SITE.earlyAccessUrl}
                  class={`btn plan-cta ${p.popular ? 'btn-secondary' : 'btn-ghost'}`}
                >
                  Coming soon
                </a>
              ) : (
                <a href="/contact" class="btn btn-ghost plan-cta">
                  Talk to sales
                </a>
              )}
              <ul class="plan-ladder">
                {p.ladder.map((item) => (
                  <li>
                    <Icon name="check" size={16} /> {item}
                  </li>
                ))}
              </ul>
              <details class="plan-features">
                <summary>See all features</summary>
                {TIER_FEATURE_GROUPS.map((g) => {
                  const feats = g.features.filter((f) => f.tiers[i] !== false);
                  return feats.length ? (
                    <div class="pf-group">
                      <h4>{g.category}</h4>
                      <ul>
                        {feats.map((f) => (
                          <li>
                            <Icon name="check" size={14} />
                            <span>
                              {f.label}
                              {typeof f.tiers[i] === 'string' && <em> &middot; {f.tiers[i]}</em>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : null;
                })}
              </details>
            </div>
          ))
        }
      </div>
      <p class="plan-note reveal">
        Additional active employees are ${OVERAGE_RATE} per month flat on Launch, Growth, and
        Scale, shown live in your billing dashboard as they are incurred. An active employee is
        anyone with a login used at least once in the billing period.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="reveal est-head">
        <h2>Put your own numbers in</h2>
        <p class="lede">
          Pick the shape of your operation and drag the team size; the totals update live across
          every published tier.
        </p>
      </div>
      <div class="reveal">
        <PricingEstimator />
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <h2 class="reveal">What the add-ons actually do</h2>
      <p class="lede reveal">
        {/* MKT-1: this used to promise "everything listed here is live in the
            product today", which stopped being true the moment the list became
            the real catalog — three of these are not built yet. The badge on
            each card is now the honest answer, so the intro points at it
            instead of making a blanket claim over the top of it. */}
        Each tier card above lists which add-ons it can install; this is what they are. Each one
        shows whether it is available now or still coming, and nothing is marked available before
        it ships.
      </p>
      <div class="grid-2 addon-grid">
        {
          addons.map((a) => (
            <div class="card reveal">
              <span class="card-icon">
                <Icon name={a.icon as any} />
              </span>
              <h3>{a.name}</h3>
              {/* MKT-1: prices come from the app's platform_addons catalog, so
                  the site cannot quote a number the product does not charge. */}
              <p class="addon-price">{a.price}</p>
              <p>{a.body}</p>
              <span
                class={`badge addon-badge ${a.availability === 'Coming soon' ? 'badge-amber' : 'badge-sage'}`}
              >{a.availability}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="container reveal enterprise-block">
      <span class="eyebrow">Enterprise</span>
      <h2>For franchise and multi-brand parents</h2>
      <p class="lede">
        Enterprise is not a size, it is a structure: a parent organization overseeing separately
        run child businesses that roll up to it. It includes franchise management, automatic
        royalty billing, regional dashboards, a custom employee allowance, and a dedicated
        account manager, priced by contract against your locations, allowance, and term.
      </p>
      <a href="/contact" class="btn btn-primary">Talk to sales about Enterprise</a>
    </div>
  </section>

  <section class="section-alt">
    <div class="container reveal">
      <FaqBlock faqs={faqs} heading="Pricing questions, answered straight" />
    </div>
  </section>

  <CtaSection
    heading="Lock in your place at the front"
    body={`HoundStack opens soon, and every account will start with ${TRIAL_DAYS} days of Launch free, no credit card, purely time based. Join early access and be first to judge it on your own operation.`}
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .tiers-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .billing-toggle {
    display: inline-flex;
    border: 1.5px solid var(--line);
    border-radius: 100px;
    padding: 3px;
    background: #ffffff;
    flex-shrink: 0;
  }

  .bt-opt {
    border: none;
    background: transparent;
    padding: 8px 18px;
    border-radius: 100px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--ink-muted);
    cursor: pointer;
    white-space: nowrap;
  }

  .bt-opt.is-active {
    background: var(--navy);
    color: #ffffff;
  }

  /* MKT-3: the tier cards used to be independently-sized boxes in a plain
     grid, so nothing lined up across them. Each card's price, employee
     allowance and audience blurb wrap to a different number of lines, which
     staggered every row below: at 1280px the four "Coming soon" buttons sat
     at four different heights and the "See all features" divider was spread
     over 117px. `min-height: 4em` on the blurb was an attempt to hold one of
     those rows level and was simply too short for the three-line blurbs.
     A price comparison whose rows do not line up is not a comparison.

     Each card is now a subgrid sharing the outer grid's row tracks, so every
     row is sized by the tallest card and the four cards line up by
     construction — no per-element magic numbers to go stale the next time
     someone edits the copy in site.ts. Row gap is moved onto the cards
     themselves because the outer grid's rows are now INSIDE the cards. */
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 18px;
    row-gap: 0;
    margin-top: 32px;
    margin-bottom: -18px;
  }

  @media (max-width: 1020px) {
    .plan-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .plan-grid {
      grid-template-columns: 1fr;
    }
  }

  .plan-card {
    padding: 24px;
    position: relative;
    margin-bottom: 18px;
    /* 7 in-flow children: title, price, allowance, blurb, CTA, ladder,
       feature list. The "Most popular" badge is absolutely positioned and
       so is not a grid item. */
    grid-row: span 7;
    display: grid;
    grid-template-rows: subgrid;
    /* Equal on every card, so the subgrid tracks start at the same offset
       inside each one; only the colour changes for the popular tier. */
    border-width: 2px;
  }

  /* The popular tier used to also be raised 8px above the row. A negative
     margin moves a subgrid item's tracks with it, which would re-introduce
     the misalignment this section exists to remove — and the 2px sage
     border, the lift shadow and the badge already mark it out. */
  .plan-popular {
    border-color: var(--sage);
    box-shadow: var(--shadow-lift);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--sage);
    color: #ffffff;
  }

  .plan-card h3 {
    margin-bottom: 6px;
  }

  .plan-price {
    margin-bottom: 4px;
  }

  /* The billing toggle swaps which price rendering is shown */
  .price-yearly {
    display: none;
  }

  .plan-grid.billing-yearly .price-yearly {
    display: block;
  }

  /* MKT-3: the yearly suffix used to read "/mo billed yearly" on one line,
     which wrapped mid-phrase inside a 235px card and left "yearly" orphaned
     on its own line against the allowance below it. It is its own line now,
     deliberately, so the wrap is the design rather than an accident. */
  .plan-billed {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-faint);
  }

  .plan-grid.billing-yearly .price-monthly {
    display: none;
  }

  .plan-amount {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.02em;
  }

  .plan-custom {
    font-size: 1.35rem;
  }

  .plan-suffix {
    color: var(--ink-faint);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .plan-emp {
    font-weight: 650;
    color: var(--sage-dark);
    font-size: 0.9rem;
    margin-bottom: 10px;
  }

  /* The 4em floor is gone: the shared row track is now sized by the tallest
     blurb in the row, which the fixed height was never able to track. */
  .plan-blurb {
    font-size: 0.92rem;
    margin-bottom: 14px;
  }

  /* align-self, or a card whose CTA row is taller than its own button
     stretches the button to fill it. */
  .plan-cta {
    width: 100%;
    justify-content: center;
    margin-bottom: 4px;
    align-self: start;
  }

  .plan-ladder {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    align-content: start;
    gap: 9px;
    font-size: 0.88rem;
    color: var(--ink-muted);
  }

  .plan-ladder li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 8px;
    align-items: start;
  }

  .plan-ladder svg {
    color: var(--sage-dark);
    margin-top: 3px;
  }

  /* Complete per-tier feature list, collapsed by default */
  .plan-features {
    margin-top: 16px;
    border-top: 1px solid var(--line-soft);
    padding-top: 12px;
  }

  .plan-features summary {
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--sage-dark);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .plan-features summary::-webkit-details-marker {
    display: none;
  }

  .plan-features summary::after {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 160ms ease;
    margin-top: -3px;
  }

  .plan-features[open] summary::after {
    transform: rotate(-135deg);
    margin-top: 3px;
  }

  .pf-group {
    margin-top: 14px;
  }

  .pf-group h4 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }

  .pf-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 7px;
    font-size: 0.84rem;
    color: var(--ink-muted);
  }

  .pf-group li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 8px;
    align-items: start;
  }

  .pf-group li svg {
    color: var(--sage-dark);
    margin-top: 3px;
  }

  .pf-group em {
    font-style: normal;
    color: var(--ink-faint);
  }

  .plan-note {
    margin-top: 28px;
    color: var(--ink-muted);
    max-width: 52em;
  }

  .est-head {
    margin-bottom: 28px;
  }

  .addon-grid {
    margin-top: 32px;
  }

  .addon-badge {
    margin-top: 14px;
  }

  /* MKT-1: the price sits directly under the name so the figure is impossible
     to miss and impossible to confuse with the description below it. */
  .addon-price {
    margin-top: 4px;
    font-weight: 600;
    color: var(--ink);
  }

  .enterprise-block .lede {
    max-width: 52em;
  }
</style>

<script>
  // Monthly/yearly billing toggle: swaps the rendered price on each
  // tier card. Both prices are rendered server-side; this only flips
  // which one is visible.
  // "See all features" opens every plan's list together, so the four
  // tiers stay comparable side by side instead of one card growing alone.
  const featureLists = document.querySelectorAll<HTMLDetailsElement>('details.plan-features');
  featureLists.forEach((d) => {
    d.querySelector('summary')!.addEventListener('click', (e) => {
      e.preventDefault();
      const open = !d.open;
      featureLists.forEach((x) => (x.open = open));
    });
  });

  const grid = document.getElementById('plan-grid')!;
  const opts = document.querySelectorAll<HTMLButtonElement>('[data-billing-opt]');
  opts.forEach((btn) =>
    btn.addEventListener('click', () => {
      grid.classList.toggle('billing-yearly', btn.dataset.billingOpt === 'yearly');
      opts.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
    })
  );
</script>
