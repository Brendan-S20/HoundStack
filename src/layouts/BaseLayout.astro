---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GetStartedPopup from '../components/GetStartedPopup.astro';
import { SITE, ORG_ID } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks for this page */
  schema?: object[];
  ogType?: string;
  /** Keep utility pages (e.g. the thank-you page) out of search results */
  noindex?: boolean;
}

const { title, description, schema = [], ogType = 'website', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, ''), SITE.url).href;

// The get-started prompt stays off pages where it would be noise or
// worse: legal documents, the forms it would interrupt, and errors.
const noPopup = ['/privacy', '/terms', '/sms-consent', '/contact', '/early-access', '/thank-you', '/404'];
const showPopup = !noPopup.some((p) => Astro.url.pathname.startsWith(p));
const ogImage = new URL('/og.png', SITE.url).href;
const ogImageAlt = 'HoundStack: software for pet waste removal businesses';

// MKT-6: `@id` so other pages' blocks (the pricing SoftwareApplication, the
// blog's Article publisher) can point at this one organization rather than
// each declaring a separate, unrelated entity with the same name.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'HoundStack',
  url: SITE.url,
  logo: new URL('/icon-512.png', SITE.url).href,
  description:
    'HoundStack is business software built for pet waste removal companies: scheduling, routing, billing, field operations, and growth tools in one app.',
  // The one contact channel the site actually publishes — /privacy, /terms
  // and /sms-consent all point at it. Deliberately no `sameAs`: there are no
  // social profiles to link yet, and guessing at handles is how a knowledge
  // panel ends up citing somebody else's account as ours.
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'support@houndstack.com',
    availableLanguage: 'English',
  },
};

const allSchema = [organizationSchema, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Stamped as early as possible so .reveal only hides content when
      // the reveal script is actually going to run.
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#142937" />

    <link
      rel="preload"
      href="/fonts/inter-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="HoundStack" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {allSchema.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- The apex and the www form are two different sites to Plausible. This
         must match the host that actually serves the page — SITE.url, and so
         every canonical URL published, is the www form — or the events are
         sent and silently dropped against a property that never loads. -->
    <script
      defer
      data-domain="www.houndstack.com"
      src="https://plausible.io/js/script.outbound-links.js"
    ></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
    </script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {showPopup && <GetStartedPopup />}

    <script>
      // Scroll-triggered reveals. Elements with .reveal fade in once.
      // Users with reduced motion and touch viewports get instant
      // visibility via CSS (the hidden state never applies there).
      //
      // Two mechanisms cooperate so content is never caught blank:
      // 1. An IntersectionObserver with a generous *positive* bottom
      //    rootMargin starts the fade while the element is still below
      //    the fold, so it is already at full contrast when it enters.
      // 2. A synchronous scroll/resize fallback instantly reveals (no
      //    fade) anything that made it into the viewport before the
      //    async observer callback ran — fast jumps, anchor links,
      //    scrollbar drags, restored scroll positions.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const animatable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const targets = document.querySelectorAll('.reveal');
      if (reduced || !animatable || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        let pending = new Set<Element>(targets);
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
                pending.delete(entry.target);
              }
            }
          },
          // Fire while the element is still up to 30% of a viewport below
          // the fold: the 360ms fade finishes before a normal scroll
          // brings it fully into view.
          { threshold: 0, rootMargin: '0px 0px 30% 0px' }
        );
        // Anything already in or near the viewport shows instantly with no
        // fade; only content the user scrolls to animates. Avoids the
        // low-contrast first paint on tall sections and on mid-page reloads.
        const instantReveal = (el: Element) => {
          (el as HTMLElement).style.transition = 'none';
          el.classList.add('is-visible');
          io.unobserve(el);
          pending.delete(el);
        };
        const inView = (el: Element) => {
          const r = el.getBoundingClientRect();
          return r.top < window.innerHeight * 0.92 && r.bottom > -40;
        };
        targets.forEach((el) => {
          if (inView(el)) {
            instantReveal(el);
          } else {
            io.observe(el);
          }
        });
        // Safety net: whenever the viewport moves, anything visible but
        // not yet revealed appears immediately. Runs synchronously on the
        // scroll event, so a hidden section can never survive a rendered
        // frame inside the viewport waiting on the observer.
        const catchUp = () => {
          if (!pending.size) return;
          for (const el of [...pending]) {
            if (inView(el)) instantReveal(el);
          }
        };
        window.addEventListener('scroll', catchUp, { passive: true });
        window.addEventListener('resize', catchUp, { passive: true });
        // Browsers restore mid-page scroll positions after this script runs
        // on reload or back-navigation; re-check so restored viewports are
        // never blank.
        window.addEventListener('load', catchUp, { once: true });
        window.addEventListener('pageshow', catchUp);
      }
    </script>
  </body>
</html>
