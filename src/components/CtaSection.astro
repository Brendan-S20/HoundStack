---
import { SITE, TRIAL_DAYS } from '../lib/site';

interface Props {
  heading?: string;
  body?: string;
  /** Pages where the sale starts with a conversation (e.g. HOA programs)
      lead with the contact button instead of the signup link. */
  leadWithContact?: boolean;
}

// Launch positioning, 2026-08-20: HoundStack is available. Signup is open,
// pricing is full price, and this block appears on twenty-five pages -- so it
// was doing most of the work of making a shipped product read as a preview.
const {
  heading = 'Put it on a truck this week',
  body = `HoundStack is available now. Start today with a ${TRIAL_DAYS} day free trial, no credit card, and your first 3 teammates included.`,
  leadWithContact = false,
} = Astro.props;
---

<section class="section-navy cta-section">
  <div class="container text-center reveal">
    <h2>{heading}</h2>
    <p class="lede cta-lede">{body}</p>
    <div class="cta-buttons">
      {
        leadWithContact ? (
          <>
            <a href="/contact" class="btn btn-secondary">Talk to us</a>
            <a href={SITE.signupUrl} class="btn btn-ghost">Get started</a>
          </>
        ) : (
          <>
            <a href={SITE.signupUrl} class="btn btn-secondary">Get started</a>
            <a href="/contact" class="btn btn-ghost">Talk to us</a>
          </>
        )
      }
      <a href="/pricing" class="btn btn-ghost">See pricing</a>
    </div>
    <p class="cta-note">14 day free trial · No credit card · Cancel anytime</p>
  </div>
</section>

<style>
  .cta-lede {
    margin-inline: auto;
    max-width: 40em;
  }

  .cta-buttons {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .cta-note {
    margin: 16px 0 0;
    font-size: 0.88rem;
    color: #b9c9d3;
  }
</style>
