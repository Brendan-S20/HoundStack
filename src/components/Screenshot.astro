---
// A real screenshot of the product, framed the way MockFrame frames a
// recreation — so a page that mixes the two does not visibly change materials
// halfway down.
//
// This exists because the desktop-screenshot treatment was about to be
// copy-pasted into four pages. `field-app.astro` already carried its own
// `.shot-phone` rules for the one image the site had; a second, third and
// fourth copy is how the frame around a screenshot ends up different on every
// page it appears on.
//
// ── ON THE IMAGES THEMSELVES ──────────────────────────────────────────────
//
// All captures come from the demo organization, whose data is generated by
// `seed_demo_org` in the app repo. Nothing in it is a real customer: every
// address is a New York street with no resident, every email is on
// `example.com` or a reserved `.example` domain, and no property carries a
// gate code, lock-box code or key location — the seeder does not write those
// columns at all, so a screenshot of that org cannot expose one. That is a
// property of the data, not of the framing here.

interface Props {
  /** Path under /screenshots, or any public path. */
  src: string;
  /** Intrinsic width of the capture, for aspect-ratio reservation. */
  width: number;
  /** Intrinsic height of the capture. */
  height: number;
  /** What is in the picture, for someone who cannot see it. Not a caption. */
  alt: string;
  variant?: 'desktop' | 'phone';
  class?: string;
}

const { src, width, height, alt, variant = 'desktop', class: className } = Astro.props;
---

<figure class={`shot shot-${variant} ${className ?? ''}`}>
  {
    variant === 'desktop' && (
      <div class="shot-bar" aria-hidden="true">
        <span /><span /><span />
      </div>
    )
  }
  <img
    src={src}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    alt={alt}
  />
</figure>

<style is:global>
  .shot {
    margin: 0;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The same three-dot browser bar MockFrame draws, so a screenshot and a
     recreation sitting in the same column read as the same kind of object. */
  .shot-bar {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    background: var(--paper, #f6f7f9);
    border-bottom: 1px solid var(--line);
  }

  .shot-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }

  /* Handset proportions, matching .mock-phone rather than approximating it. */
  .shot-phone {
    width: min(310px, 100%);
    margin-inline: auto;
    border-radius: 36px;
    border: 7px solid var(--navy);
    box-shadow: var(--shadow-lift);
  }

  .shot-phone img {
    border-radius: 28px;
  }
</style>
